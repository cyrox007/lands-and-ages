extends RefCounted
## Контракт применения природного сырья в будущих производственных цепочках.
## Это зависимости материалов, а не готовая экономика или числовые рецепты.

# Конечные потребности: продукт полезен, когда у него есть назначение.
# Для каждого назначения позднее появится настоящий потребитель в игре.
const FINAL_USES := {
    "камень": ["фундаменты", "каменная кладка"],
    "щебень": ["дороги", "дренаж"],
    "песок": ["дорожная подсыпка"],
    "глина": ["глинобитные постройки"],
    "древесина": ["деревянные конструкции", "топливо"],
    "строительный раствор": ["кладка"],
    "обожжённый кирпич": ["строительство"],
    "железные инструменты": ["добыча", "строительство", "земледелие"],
    "медные изделия": ["ремесло", "строительные детали"],
    "бронзовые инструменты": ["ремесло", "добыча"],
    "каменный уголь": ["топливо для производства"]
}

# Направленные преобразования связывают исходные материалы с потребностями.
# Количество, технологии, топливо и рабочие будут определены при создании
# производственных объектов, чтобы не выдавать эти связи за готовые рецепты.
const TRANSFORMATIONS := [
    {"inputs": ["песок", "глина"], "output": "строительный раствор"},
    {"inputs": ["глина", "древесина"], "output": "обожжённый кирпич"},
    {"inputs": ["железная руда", "каменный уголь"], "output": "железо"},
    {"inputs": ["железо", "древесина"], "output": "железные инструменты"},
    {"inputs": ["медная руда", "каменный уголь"], "output": "медь"},
    {"inputs": ["медь"], "output": "медные изделия"},
    {"inputs": ["оловянная руда", "каменный уголь"], "output": "олово"},
    {"inputs": ["медь", "олово"], "output": "бронза"},
    {"inputs": ["бронза", "древесина"], "output": "бронзовые инструменты"}
]


static func demanded_materials() -> Dictionary:
    # Начинаем с материалов, которые действительно нужны строительству,
    # производству или хозяйству, и идём назад к природному сырью.
    var demanded := {}
    for material in FINAL_USES:
        if not FINAL_USES[material].is_empty():
            demanded[material] = true
    var changed := true
    while changed:
        changed = false
        for process in TRANSFORMATIONS:
            # Промежуточный продукт нужен лишь при наличии конечного спроса.
            if not demanded.has(process["output"]):
                continue
            for ingredient in process["inputs"]:
                if demanded.has(ingredient):
                    continue
                demanded[ingredient] = true
                changed = true
    return demanded


static func unused_sources(source_kinds: Array) -> Array[String]:
    # Сверяем виды сырья генератора с цепочками реального назначения.
    # Любой новый природный ресурс без пути к потребителю провалит тест.
    var demanded := demanded_materials()
    var missing: Array[String] = []
    for raw_kind in source_kinds:
        var kind := str(raw_kind)
        if not demanded.has(kind) and not missing.has(kind):
            missing.append(kind)
    missing.sort()
    return missing
